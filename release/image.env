# Release metadata for this branch, read by release/build-on-builder.sh.
# Plain KEY=value lines only.
#
# 5.2.3-2 replaces four start-up files of the released 5.2.3-1 image and
# removes the database password variables (see Dockerfile.release).
# release/release-gate.py tests it; release/verify-image.sh was the gate for
# the 5.2.3-1 PHP package upgrade and is kept for reference.
cylo_build_kind=patch
cylo_build_repo_slug=mautic-app
cylo_build_image=mautic
cylo_build_tag=5.2.3-2
cylo_build_release_ref=repo.cylo.net/mautic:5.2.3-2
cylo_build_dockerfile=Dockerfile.release
cylo_build_gate=release/release-gate.py
cylo_build_git_remote=origin
cylo_build_git_branch=php-multipart-fix
# builder1.builder.appboxes.co:10112 has no DNS record since 27 October 2026,
# so this release builds on builder.grant.appboxes.co:12246.
cylo_build_builder=appbox@builder.grant.appboxes.co
cylo_build_builder_port=12246
