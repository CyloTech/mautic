# Release metadata for this branch, read by release/build-on-builder.sh and
# release/verify-image.sh. Plain KEY=value lines only.
cylo_build_kind=apt
cylo_build_repo_slug=mautic-app
cylo_build_image=mautic
cylo_build_tag=5.2.3-1
cylo_build_release_ref=repo.cylo.net/mautic:5.2.3-1
cylo_build_dockerfile=Dockerfile.release
cylo_build_git_remote=origin
cylo_build_git_branch=php-multipart-fix
# The deployed image the release is built on (the current and only tag,
# `latest`, built 2025-03-10 with Mautic 5.2.3).
gate_base_ref=repo.cylo.net/mautic@sha256:23b8c612ed851368d870c5b1a52aef68b4469eafe62ef84ecf7b16105146de13
# Ubuntu source package whose binaries are upgraded, its extension directory
# and the web server that loads PHP (mod_php).
gate_php_source=php8.3
gate_php_extension_dir=/usr/lib/php/20230831
gate_web_server=apache2
# The start-up script enables mod_remoteip, which the Apache site needs.
gate_web_prepare=a2enmod-remoteip
