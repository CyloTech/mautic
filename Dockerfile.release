# Mautic 5.2.3-2: the released 5.2.3-1 image (Mautic 5.2.3, php8.3
# 8.3.6-0ubuntu0.24.04.13) with only these files replaced:
#
#   scripts/mysql.sh       -> /scripts/mysql.sh
#   scripts/mautic.sh      -> /scripts/mautic.sh
#   scripts/30_installer.sh -> /etc/my_init.d/30_installer.sh
#   sources/mysqld.cnf     -> /sources/mysqld.cnf
#
# MySQL listens on 127.0.0.1 only, root has no remote login, a new install
# gets its own random database password, and no password is baked into the
# image. The earlier images set MYSQL_ROOT_PASSWORD, MAUTIC_DB_PASSWORD and
# DB_PASS with ENV. An ENV cannot be removed from a child image, and the value
# would also stay in the image history, so the second stage copies the file
# system into a new image and declares the rest of the configuration again,
# unchanged. release/release-gate.py checks that every other file and setting
# matches 5.2.3-1.

FROM repo.cylo.net/mautic@sha256:3ddd2316159d803776a2b3ba187f883e3ecd8c02b9e85a8f6d1bfad3a059a6b6 AS patched

COPY scripts/mysql.sh scripts/mautic.sh /scripts/
COPY scripts/30_installer.sh /etc/my_init.d/30_installer.sh
COPY sources/mysqld.cnf /sources/mysqld.cnf
RUN chown root:root /scripts/mysql.sh /scripts/mautic.sh /etc/my_init.d/30_installer.sh /sources/mysqld.cnf \
    && chmod 755 /scripts/mysql.sh /scripts/mautic.sh /etc/my_init.d/30_installer.sh \
    && chmod 644 /sources/mysqld.cnf

FROM scratch

COPY --from=patched / /

LABEL maintainer="Luiz Eduardo Oliveira Fonseca <luiz@powertic.com>" \
      org.opencontainers.image.ref.name="ubuntu" \
      org.opencontainers.image.version="24.04" \
      vendor="Mautic"

ENV PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
    DEBIAN_FRONTEND=noninteractive \
    LANG=en_US.UTF-8 \
    LANGUAGE=en_US:en \
    LC_ALL=en_US.UTF-8 \
    APEX_CALLBACK=false \
    INSTALL_MYSQL=true \
    INSTALL_NGINXPHP=true \
    INSTALL_MONGODB=false \
    DB_NAME=mautic \
    DB_USER=root \
    APACHE_CONFDIR=/etc/apache2 \
    APACHE_ENVVARS=/etc/apache2/envvars \
    APACHE_RUN_USER=appbox \
    APACHE_RUN_GROUP=appbox \
    APACHE_LOG_DIR=/home/appbox/logs/apache \
    MAUTIC_MESSENGER_DSN_EMAIL=doctrine://default \
    MAUTIC_MESSENGER_DSN_HIT=doctrine://default \
    MAUTIC_VERSION=5.2.3 \
    MAUTIC_SHA1=6dd1cbe24e050bbe496a3d8695a8938207244bea \
    MAUTIC_DB_USER=root \
    MAUTIC_DB_NAME=mautic \
    MAUTIC_DB_HOST=localhost \
    MYSQL_PORT_3306_TCP=3306 \
    PHP_INI_DATE_TIMEZONE=UTC \
    PHP_MEMORY_LIMIT=512M \
    PHP_MAX_UPLOAD=128M \
    PHP_MAX_EXECUTION_TIME=300

VOLUME /home/appbox/public_html
WORKDIR /home/appbox/public_html
EXPOSE 80 3306

CMD ["/sbin/my_init"]
